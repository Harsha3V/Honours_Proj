# ============================================================
# .gitignore — Honours Project RTL SoC
# ============================================================

# ----- VCS / Synopsys Simulation Artifacts -----
simv
simv.daidir/
csrc/
*.key
ucli.key
vc_hdrs.h

# ----- Verdi / Novas -----
*.fsdb
novas.conf
novas.rc
novas_dump.log
verdiLog/
verdi_config_file
*.vf
*.vpd

# ----- Waveform dumps -----
*.vcd
*.shm/
*.trn
*.dsn

# ----- Compile / build logs -----
compile.log
*.log
*.err

# ----- Synopsys Design Compiler -----
*.ddc
*.svf
*.mr
work/
WORK/
mapped/
unmapped/
reports/
.synopsys_dc.setup

# ----- Cadence -----
xcelium.d/
*.diag
*.history
.simvision/

# ----- Python -----
__pycache__/
*.pyc
*.pyo
*.egg-info/
.env

# ----- OS junk -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Editor junk -----
*.swp
*.swo
*~
.vscode/
.idea/

# ----- Keep empty folders tracked -----
!**/.gitkeep
